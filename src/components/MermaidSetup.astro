---
// src/components/MermaidSetup.astro
// Cleanly handles client-side rendering for mermaid markdown codeblocks across all pages
---

<script>
  import mermaid from "mermaid";
  
  let isRendering = false;

  const renderMermaid = async () => {
    if (isRendering) return;
    isRendering = true;
    
    try {
      // 0. Reliably get current theme taking into account local storage and OS preferences
      const theme = localStorage.getItem('theme');
      let isDark = document.documentElement.classList.contains('dark');
      
      if (theme === 'dark') isDark = true;
      else if (theme === 'light') isDark = false;
      else if (window.matchMedia('(prefers-color-scheme: dark)').matches) isDark = true;
      
      // Force the class synchronously so any CSS-based checks within Mermaid also pass
      if (isDark) document.documentElement.classList.add('dark');

      // Update config natively without re-init which might get trapped
      mermaid.initialize({ 
        startOnLoad: false,
        theme: isDark ? 'dark' : 'neutral',
        securityLevel: 'loose',
        themeVariables: {
          background: 'transparent'
        }
      });

      // 1. Process raw markdown code blocks
      const codeBlocks = document.querySelectorAll('.astro-code[data-language="mermaid"]');
      for (let i = 0; i < codeBlocks.length; i++) {
        const el = codeBlocks[i];
        const code = el.textContent || '';
        
        const wrapper = document.createElement('div');
        wrapper.className = 'mermaid-wrapper flex justify-center my-6 overflow-x-auto';
        wrapper.setAttribute('data-code', code);
        
        if (el.parentNode) el.parentNode.replaceChild(wrapper, el);
      }

      // 2. Erase existing children before rendering to prevent artifact duplication
      const wrappers = document.querySelectorAll('.mermaid-wrapper');
      for (let i = 0; i < wrappers.length; i++) {
        const wrapper = wrappers[i];
        const code = wrapper.getAttribute('data-code');
        if (code) {
          // Clear it completely
          wrapper.innerHTML = '';
          const id = 'mermaid-svg-' + Math.random().toString(36).substr(2, 9);
          try {
            const { svg } = await mermaid.render(id, code);
            wrapper.innerHTML = svg;
          } catch (e) {
            console.error("Mermaid rendering failed:", e);
          }
        }
      }
    } finally {
      isRendering = false;
    }
  };

  // Run immediately on Astro page transitions
  // Use a slight timeout on page-load to ensure Head.astro has completed injecting classes
  // specifically during View Transitions.
  document.addEventListener("astro:page-load", () => {
    setTimeout(renderMermaid, 50); 
  });

  // Clear out injected containers right before Astro starts morphing the DOM 
  document.addEventListener("astro:before-preparation", () => {
    const wrappers = document.querySelectorAll('.mermaid-wrapper');
    wrappers.forEach(w => w.innerHTML = '');
  });

  // Watch for the user clicking the light/dark mode toggle button
  document.addEventListener('DOMContentLoaded', () => {
    let lastTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    
    const observer = new MutationObserver(() => {
      const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
      if (currentTheme !== lastTheme) {
        lastTheme = currentTheme;
        // Small timeout allows Astro's Head script toggles to complete their style injections
        setTimeout(() => renderMermaid(), 10);
      }
    });
    
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  });
</script>
