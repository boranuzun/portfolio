---

---

<div
  id="cmd-palette"
  class="hidden fixed inset-0 z-100 items-start justify-center pt-[10vh] sm:pt-[20vh] px-3 sm:px-4"
  style="background-color: rgba(0, 0, 0, 0.5); backdrop-filter: blur(4px);"
>
  <div class="w-full max-w-sm sm:max-w-2xl terminal-card p-0 overflow-hidden">
    <div class="flex items-center gap-2 px-4 py-3 border-b border-terminal-light-border dark:border-terminal-border">
      <span class="text-terminal-light-accent dark:text-terminal-accent text-sm">&gt;</span>
      <input
        id="cmd-input"
        type="text"
        placeholder="search..."
        autocomplete="off"
        class="flex-1 bg-transparent outline-none font-mono text-sm text-terminal-light-text dark:text-terminal-text placeholder:text-terminal-light-text-secondary dark:placeholder:text-terminal-text-secondary"
      />
      <kbd class="text-xs opacity-50 px-1.5 py-0.5 rounded border border-terminal-light-border dark:border-terminal-border">esc</kbd>
    </div>
    <div id="cmd-results" class="max-h-64 sm:max-h-96 overflow-y-auto p-2">
    </div>
  </div>
</div>

<style>
  :global(.cmd-group) {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.5rem 0.75rem 0.25rem;
    color: var(--color-terminal-light-accent);
  }
  :global(html.dark .cmd-group) {
    color: var(--color-terminal-accent);
  }
  :global(.cmd-item) {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    text-decoration: none;
    color: var(--color-terminal-light-text-secondary);
    transition: background-color 0.15s;
  }
  :global(html.dark .cmd-item) {
    color: var(--color-terminal-text-secondary);
  }
  :global(.cmd-item:hover),
  :global(.cmd-item-active) {
    background-color: var(--color-terminal-light-code-bg);
  }
  :global(html.dark .cmd-item:hover),
  :global(html.dark .cmd-item-active) {
    background-color: var(--color-terminal-code-bg);
  }
  :global(.cmd-item-title) {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-terminal-light-text);
  }
  :global(html.dark .cmd-item-title) {
    color: var(--color-terminal-text);
  }
  :global(.cmd-item-desc) {
    font-size: 0.75rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.cmd-no-results) {
    padding: 1rem 0.75rem;
    text-align: center;
    font-size: 0.875rem;
    opacity: 0.5;
  }
</style>

<script>
  import "../scripts/command-palette.ts";
</script>
