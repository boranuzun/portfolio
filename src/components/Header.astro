---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";

const path = `/${Astro.url.pathname.split("/")[1]}`;
---

<header>
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between">
      <Link href="/" underline={false}>
        <div class="flex items-center gap-2 font-semibold">
          <img src="/B_black@1x.png" alt={SITE.NAME} class="h-8 w-8 object-contain dark:hidden" />
          <img src="/B_white@1x.png" alt={SITE.NAME} class="h-8 w-8 object-contain hidden dark:block" />
        </div>
      </Link>
      <div class="flex gap-4 items-center">
        <nav class="flex gap-1 items-center">
          <Link href="/work" class={path === "/work" ? "text-terminal-light-accent dark:text-terminal-accent" : ""}>work</Link>
          <span>{`/`}</span>
          <Link href="/projects" class={path === "/projects" ? "text-terminal-light-accent dark:text-terminal-accent" : ""}>projects</Link>
          <span>{`/`}</span>
          <Link href="/blog" class={path === "/blog" ? "text-terminal-light-accent dark:text-terminal-accent" : ""}>blog</Link>
          <span>{`/`}</span>
          <Link href="/keys" class={path === "/keys" ? "text-terminal-light-accent dark:text-terminal-accent" : ""}>keys</Link>
        </nav>
        <div class="flex flex-wrap gap-1 items-center">
          <button
            id="theme-button"
            aria-label="Toggle theme"
            class="group cursor-pointer size-8 flex items-center justify-center rounded-full relative"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="absolute inset-0 m-auto opacity-100 rotate-0 scale-100 transition-all duration-500 ease-in-out dark:opacity-0 dark:-rotate-90 dark:scale-50 origin-center group-hover:stroke-terminal-light-accent dark:group-hover:stroke-terminal-accent">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="absolute inset-0 m-auto opacity-0 rotate-90 scale-50 transition-all duration-500 ease-in-out dark:opacity-100 dark:rotate-0 dark:scale-100 origin-center group-hover:stroke-terminal-light-accent dark:group-hover:stroke-terminal-accent">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
          <button id="cmd-k-trigger" aria-label="Open command palette" class="hidden md:flex items-center gap-1 px-2 py-1 rounded border text-xs cursor-pointer transition-colors duration-300" style="border-color: var(--color-terminal-light-border); color: var(--color-terminal-light-text-secondary);">
            <kbd>&#8984;K</kbd>
          </button>
        </div>
      </div>
    </div>
  </Container>
</header>

<style>
  #cmd-k-trigger {
    border-color: var(--color-terminal-light-border);
    color: var(--color-terminal-light-text-secondary);
  }
  :global(html.dark) #cmd-k-trigger {
    border-color: var(--color-terminal-border);
    color: var(--color-terminal-text-secondary);
  }
  #cmd-k-trigger:hover {
    border-color: var(--color-terminal-light-accent);
    color: var(--color-terminal-light-accent);
  }
  :global(html.dark) #cmd-k-trigger:hover {
    border-color: var(--color-terminal-accent);
    color: var(--color-terminal-accent);
  }
</style>
