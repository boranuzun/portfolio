---
import Container from "@components/Container.astro";
import { Command, Sun, Moon } from "@lucide/astro";
import { SITE } from "@consts";

const path = `/${Astro.url.pathname.split("/")[1]}`;

const navLinks = [
	// { href: "/", label: "index" },
	{ href: "/work", label: "work" },
	{ href: "/projects", label: "projects" },
	{ href: "/blog", label: "blog" },
	// { href: "/keys", label: "keys" },
];
---

<header transition:persist>
	<Container>
		<div class="flex flex-wrap justify-between gap-y-2 py-3">
			{/* Logo */}
			<a href="/" class="text-accent font-semibold no-underline">
				<img src="/B_black@1x.png" alt={SITE.NAME} class="h-8 w-8 object-contain dark:hidden" />
				<img
					src="/B_white@1x.png"
					alt={SITE.NAME}
					class="hidden h-8 w-8 object-contain dark:block"
				/>
			</a>

			{/* Nav + cmdk */}
			<div class="flex items-center gap-3">
				<nav class="flex items-center" aria-label="Main navigation">
					{
						navLinks.map((link, i) => (
							<>
								<a
									href={link.href}
									class={`${path === link.href ? "text-fg-bright" : "text-fg-muted"} hover:text-accent text-base no-underline transition-colors duration-200`}
									aria-current={path === link.href ? "page" : undefined}
								>
									{link.label}
								</a>
								{i < navLinks.length - 1 && (
									<span class="text-fg-dim px-1.5 font-bold select-none" aria-hidden="true">
										/
									</span>
								)}
							</>
						))
					}
				</nav>

				{/* Theme toggle */}
				<button
					id="theme-button"
					class="text-fg-muted hover:text-accent flex items-center justify-center transition-colors duration-200"
					aria-label="Toggle theme"
				>
					<Sun size={16} class="sun-icon transition-transform duration-300" />
					<Moon size={16} class="moon-icon absolute transition-transform duration-300" />
				</button>

				{/* cmdk trigger */}
				<button
					id="cmd-k-trigger"
					aria-label="Open command palette"
					class="cmdk-btn text-fg-muted hover:text-accent hover:border-accent border-border bg-surface-dim hidden items-center gap-1.5 rounded-md border px-2 py-1 text-[0.7rem] transition-all duration-200 md:flex"
				>
					<Command size={12} aria-hidden="true" />
					<span>K</span>
				</button>
			</div>
		</div>
	</Container>
</header>

<style>
	#theme-button {
		position: relative;
		width: 24px;
		height: 24px;
	}

	.sun-icon {
		transform: rotate(0deg) scale(1);
		opacity: 1;
	}

	.moon-icon {
		transform: rotate(90deg) scale(0);
		opacity: 0;
	}

	:global(html.dark) .sun-icon {
		transform: rotate(-90deg) scale(0);
		opacity: 0;
	}

	:global(html.dark) .moon-icon {
		transform: rotate(0deg) scale(1);
		opacity: 1;
	}
</style>
