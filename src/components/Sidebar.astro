---
type Props = {
	headings: { depth: number; slug: string; text: string }[];
};

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{/* Mobile: collapsible TOC */}
{
	filteredHeadings.length > 0 && (
		<div class="mb-8 md:hidden">
			<details>
				<summary class="comment-label cursor-pointer select-none">// table of contents</summary>
				<ul class="mt-2 flex list-none flex-col gap-1 pl-0 text-sm">
					{filteredHeadings.map((heading) => (
						<li class:list={[heading.depth === 3 && "pl-3"]}>
							<a
								href={`#${heading.slug}`}
								class="text-terminal-light-text-secondary hover:text-terminal-light-accent dark:text-terminal-text-secondary dark:hover:text-terminal-accent block py-0.5 no-underline"
							>
								{heading.text}
							</a>
						</li>
					))}
				</ul>
			</details>
		</div>
	)
}
