---
import { cn } from "@lib/utils";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & {
  href: string;
  external?: boolean;
  underline?: boolean;
}

const { href, external, underline = true, class: className, ...rest } = Astro.props;
---

<a
  href={href}
  target={ external ? "_blank" : "_self" }
  class={cn(
    "inline-block transition-colors duration-300 ease-in-out",
    "text-terminal-light-text-secondary hover:text-terminal-light-accent",
    "dark:text-terminal-text-secondary dark:hover:text-terminal-accent",
    underline && "underline underline-offset-2 decoration-current/30 hover:decoration-current/60",
    className
  )}
  {...rest}>
  <slot/>
</a>
