---
type Props = {
	name: string;
};

const { name } = Astro.props;
---

<span
	class="border-terminal-light-border text-terminal-light-text-secondary dark:border-terminal-border dark:text-terminal-text-secondary inline-block rounded border px-2 py-0.5 text-xs transition-colors duration-300"
>
	{name}
</span>
