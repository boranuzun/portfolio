---
import type { CollectionEntry } from "astro:content";
import Pill from "@components/Pill.astro";
import { formatDate, readingTime } from "@lib/utils";

type Props = {
	entry: CollectionEntry<"blog">;
};

const { entry } = Astro.props;
const href = `/blog/${entry.id}`;
const tags = entry.data.tags;
---

<a
	href={href}
	class="group border-border/30 hover:bg-surface/20 -mx-2 flex items-start justify-between gap-4 border-b px-2 py-4 no-underline transition-colors duration-200 last:rounded-b-sm last:border-b-0 first-of-type:rounded-t-sm sm:-mx-3 sm:px-3"
>
	<div class="min-w-0 flex-1">
		<span
			transition:name={`post-title-${entry.id}`}
			class="text-fg-bright group-hover:text-accent text-md font-medium transition-colors duration-200"
		>
			{entry.data.title}
		</span>
		<p class="text-fg-muted mt-1 text-sm">{entry.data.description}</p>
		{
			tags && tags.length > 0 && (
				<div transition:name={`post-tags-${entry.id}`} class="mt-2 flex flex-wrap gap-1.5">
					{tags.map((tag) => (
						<Pill name={tag} class="border-tag/30 bg-tag/10 text-tag px-1 py-0.5" />
					))}
				</div>
			)
		}
	</div>
	<div class="text-fg-muted/90 shrink-0 text-right font-mono text-xs leading-relaxed">
		<div>{formatDate(entry.data.date)}</div>
		<div>{readingTime(entry.body ?? "")}</div>
	</div>
</a>
