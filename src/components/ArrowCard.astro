---
import type { CollectionEntry } from "astro:content";

type Props = {
	entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props;
const href = `/${entry.collection}/${entry.id}`;
---

<a
	href={href}
	class="border-terminal-light-border dark:border-terminal-border block border-b py-4 pr-8"
>
	<p
		class="text-terminal-light-text group-hover:text-terminal-light-accent dark:text-terminal-text dark:group-hover:text-terminal-accent font-semibold text-balance transition-colors duration-300 ease-in-out"
	>
		{entry.data.title}
	</p>
	<p class="mt-0.5 line-clamp-2 text-sm text-pretty">
		{entry.data.description}
	</p>
</a>
<aside
	class="group-hover:bg-terminal-light-code-bg dark:group-hover:bg-terminal-code-bg absolute inset-0 -inset-x-3 -top-px -z-10 transition-colors duration-300 ease-in-out"
	aria-hidden="true"
>
</aside>
<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	aria-hidden="true"
	class="absolute top-1/2 right-2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2"
>
	<line
		x1="5"
		y1="12"
		x2="19"
		y2="12"
		class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100"
	></line>
	<polyline
		points="12 5 19 12 12 19"
		class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0"
	></polyline>
</svg>
