---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const href = `/${entry.collection}/${entry.id}`;
---

<a
  href={href}
  class="block border-b py-4 pr-8 border-terminal-light-border dark:border-terminal-border"
>
  <p class="font-semibold text-terminal-light-text group-hover:text-terminal-light-accent dark:text-terminal-text dark:group-hover:text-terminal-accent transition-colors duration-300 ease-in-out text-balance">
    {entry.data.title}
  </p>
  <p class="text-sm text-pretty line-clamp-2 mt-0.5">
    {entry.data.description}
  </p>
</a>
<aside
  class="absolute -z-10 inset-0 -inset-x-3 -top-px group-hover:bg-terminal-light-code-bg dark:group-hover:bg-terminal-code-bg transition-colors duration-300 ease-in-out"
  aria-hidden="true"
/>
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  aria-hidden="true"
  class="absolute top-1/2 right-2 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current">
  <line x1="5" y1="12" x2="19" y2="12" class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out" />
  <polyline points="12 5 19 12 12 19" class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out" />
</svg>
