---
const chatbotUrl = import.meta.env.PUBLIC_CHATBOT_URL || 'http://127.0.0.1:8787';
---

<div id="portfolio-chatbot" class="fixed bottom-6 right-4 sm:right-6 z-50 font-sans flex flex-col items-end" data-api-url={chatbotUrl} transition:persist>

  {/* Chat Window Panel */}
  <div id="chat-panel" class="w-[calc(100vw-2rem)] sm:w-105 max-h-[70vh] bg-white/95 dark:bg-neutral-800/95 backdrop-blur-2xl border border-black/10 dark:border-white/10 rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] dark:shadow-black flex-col overflow-hidden" style="display: none;">
    <div class="p-5 flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <div>
          <h3 class="text-lg font-mono font-medium text-black dark:text-white tracking-tight">Chat with Boran's AI</h3>
          <p class="text-[11px] uppercase tracking-wider text-black/40 dark:text-white/40 mt-0.5">Powered by Gemini 3.1 Flash-Lite</p>
        </div>
      </div>
      <div class="flex items-center space-x-1">
        <button id="clear-chat-btn" title="Clear Chat" class="cursor-pointer text-black/30 dark:text-white/30 hover:text-black hover:bg-black/5 dark:hover:text-white dark:hover:bg-white/5 transition-colors duration-200 p-1.5 rounded-full" aria-label="Clear Chat">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-brush-cleaning-icon lucide-brush-cleaning"><path d="m16 22-1-4"/><path d="M19 14a1 1 0 0 0 1-1v-1a2 2 0 0 0-2-2h-3a1 1 0 0 1-1-1V4a2 2 0 0 0-4 0v5a1 1 0 0 1-1 1H6a2 2 0 0 0-2 2v1a1 1 0 0 0 1 1"/><path d="M19 14H5l-1.973 6.767A1 1 0 0 0 4 22h16a1 1 0 0 0 .973-1.233z"/><path d="m8 22 1-4"/></svg>
        </button>
        <button id="close-chat-btn" title="Close Chat" class="cursor-pointer text-black/30 dark:text-white/30 hover:text-black hover:bg-black/5 dark:hover:text-white dark:hover:bg-white/5 transition-colors duration-200 p-1.5 rounded-full" aria-label="Close Chat">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
    </div>

    <div id="chat-messages" class="flex-1 min-h-0 overflow-y-auto px-5 pb-2 pt-0 space-y-5 scrollbar-hide scroll-smooth">
      <div class="flex flex-row shrink-0 mt-2">
        <div class="max-w-[85%] py-3 px-4 rounded-2xl text-sm leading-relaxed bg-black/5 dark:bg-white/5 text-black/80 dark:text-white/80 border-l-2 border-l-black/20 dark:border-l-white/20 wrap-break-words rounded-tl-sm shadow-sm">
          Hey! 👋 I know all about Boran's experience, projects, and skills. What would you like to know?
        </div>
      </div>
    </div>

    <div id="chat-disclaimer" class="px-5 pb-0 pt-2 shrink-0 flex justify-center animate-fade-in-up relative z-10 -mb-1">
      <div class="flex items-center gap-1.5 opacity-80 hover:opacity-100 transition-opacity duration-200">
        <p class="text-[11px] leading-tight text-black/50 dark:text-white/50 text-center">AI content may be inaccurate. Review Google's <a href="https://ai.google.dev/gemini-api/terms" target="_blank" rel="noopener noreferrer" class="underline hover:text-black/70 dark:hover:text-white/70 transition-colors">terms</a>.</p>
        <button id="dismiss-disclaimer" class="cursor-pointer ml-1 text-black/40 dark:text-white/40 hover:text-black/70 dark:hover:text-white/70 hover:bg-black/5 dark:hover:bg-white/5 rounded-full transition-colors shrink-0 p-1.5 -mr-1.5" aria-label="Dismiss disclaimer">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
        </button>
      </div>
    </div>
    <form id="chat-form" class="p-4 shrink-0 relative z-20">
      <div class="relative">
        <input id="chat-input" placeholder="Ask me anything..." class="w-full bg-white dark:bg-black border border-black/10 dark:border-white/10 text-black dark:text-white text-base sm:text-sm rounded-full py-3.5 pl-5 pr-14 focus:outline-none focus:border-black/20 dark:focus:border-white/20 shadow-[0_2px_8px_rgba(0,0,0,0.04)] dark:shadow-[0_2px_8px_rgba(255,255,255,0.04)] transition-all duration-200 placeholder:text-black/30 dark:placeholder:text-white/30" type="text" autocomplete="off" required>
        <button id="chat-submit" type="submit" disabled class="cursor-pointer absolute right-1.5 top-1/2 -translate-y-1/2 p-2 bg-black dark:bg-white text-white dark:text-black rounded-full hover:bg-neutral-800 dark:hover:bg-neutral-200 disabled:opacity-30 disabled:cursor-not-allowed transition-colors duration-200" aria-label="Send message">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
        </button>
      </div>
    </form>
  </div>

  {/* Chat Toggle Button */}
  <button
    id="toggle-chat-btn"
    class="group relative flex h-14 w-14 sm:w-auto items-center justify-center gap-2.5 overflow-hidden rounded-full bg-neutral-950/90 shadow-lg shadow-black/20 backdrop-blur-md transition duration-200 ease-out hover:scale-[1.04] active:scale-95 dark:bg-white/95 dark:shadow-white/5 sm:px-6 opacity-100 scale-100"
    aria-label="Toggle AI Assistant"
  >
    <div class="pointer-events-none absolute inset-0 rounded-full ring-1 ring-inset ring-white/15 dark:ring-black/10"></div>
    <div class="relative flex items-center justify-center text-white dark:text-black">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 ease-out group-hover:rotate-12 group-hover:scale-110"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>
    </div>
    <span class="hidden font-mono text-sm font-medium tracking-tight text-white dark:text-black sm:inline-block">Ask AI</span>
  </button>
</div>

<script>
  import "../lib/chatbot/index.ts";
</script>
