---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
import BackToTop from "@components/BackToTop.astro";

const currentYear = new Date().getFullYear();
---

<footer class="animate">
  <Container>
    <div class="relative">
      <div class="absolute right-0 -top-20">
        <BackToTop />
      </div>
    </div>
    <div class="flex items-center justify-between mt-8">
      <div class="flex gap-2 items-center text-sm tabular-nums text-black/50 dark:text-white/50">
        <span>&copy; {currentYear}</span>
        <span aria-hidden="true" class="opacity-50">&bull;</span>
        <span class="font-medium text-black/75 dark:text-white/80">{SITE.NAME}</span>
      </div>
      
      <a 
        href="/privacy" 
        class="text-sm font-medium text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white transition-colors duration-200 ease-out underline underline-offset-4 decoration-black/20 dark:decoration-white/20 hover:decoration-black dark:hover:decoration-white"
      >
        Privacy Policy
      </a>
    </div>
  </Container>
</footer>
