---
import Container from "@components/Container.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PromptLine from "@components/PromptLine.astro";
import CommandBlock from "@components/CommandBlock.astro";
import { KEYS } from "@consts";
---

<BaseLayout title="Keys" description="My public encryption keys.">
	<Container>
		<article class="space-y-6">
			<h1 class="animate text-xl font-semibold text-black dark:text-white">Keys</h1>
			<p class="animate text-sm opacity-60">Public keys for encrypting messages or files to me.</p>

			<div
				class="animate not-prose max-w-full overflow-hidden rounded-lg border border-black/10 dark:border-white/10"
			>
				<div class="flex items-center gap-2 bg-neutral-200 px-4 py-2.5 dark:bg-neutral-800">
					<span class="h-3 w-3 rounded-full bg-red-400/80"></span>
					<span class="h-3 w-3 rounded-full bg-yellow-400/80"></span>
					<span class="h-3 w-3 rounded-full bg-green-400/80"></span>
					<span class="ml-3 font-mono text-xs text-black/30 dark:text-white/30"
						>boran@portfolio ~ % keys</span
					>
				</div>
				<div
					class="space-y-4 overflow-hidden bg-neutral-50 p-5 font-mono text-xs leading-relaxed dark:bg-neutral-900"
				>
					<CommandBlock command="cat ~/.age/key.txt">
						<div class="text-fg-bright text-xs leading-tight break-all">
							{KEYS.AGE}
						</div>
					</CommandBlock>

					<CommandBlock command="gpg --fingerprint contact@boranuzun.ch">
						<div class="space-y-1 text-xs leading-tight">
							<div class="text-fg-muted">pub ed25519 2026-03-17 [SC] [expire : 2028-03-16]</div>
							<div class="text-fg-bright">{KEYS.GPG_FINGERPRINT}</div>
						</div>
					</CommandBlock>

					<CommandBlock command="gpg --armor --export contact@boranuzun.ch">
						<pre
							class="text-fg-bright text-xs leading-tight break-all whitespace-pre-wrap">{KEYS.GPG}</pre>
					</CommandBlock>

					<PromptLine command="" cursor={true} />
				</div>
			</div>
		</article>
	</Container>
</BaseLayout>
