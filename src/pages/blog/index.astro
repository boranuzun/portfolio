---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/Container.astro";
import BlogPosts from "@components/BlogPosts.astro";
import { BLOG } from "@consts";
import { getPublishedEntries } from "@lib/collections";

const data = await getPublishedEntries("blog");

type Acc = {
	[year: string]: CollectionEntry<"blog">[];
};

const posts = data.reduce((acc: Acc, post) => {
	const year = post.data.date.getFullYear().toString();
	if (!acc[year]) {
		acc[year] = [];
	}
	acc[year].push(post);
	return acc;
}, {});

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));
---

<BaseLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
	<Container>
		<div class="space-y-6">
			<h1 class="text-fg-bright text-xl font-semibold">Posts</h1>

			{
				years.map((year, i) => (
					<section class={i > 0 ? "mt-6" : undefined}>
						<div class="mb-2 flex items-center gap-3">
							<span class="text-fg-dim font-mono text-xs" aria-hidden="true">
								{year}
							</span>
							<hr class="border-border/40 flex-1" />
						</div>
						{posts[year].map((post) => (
							<BlogPosts entry={post} />
						))}
					</section>
				))
			}
		</div>
	</Container>
</BaseLayout>
