---
import { type CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { BLOG } from "@consts";
import { getPublishedEntries } from "@lib/collections";

const data = await getPublishedEntries("blog");

type Acc = {
	[year: string]: CollectionEntry<"blog">[];
};

const posts = data.reduce((acc: Acc, post) => {
	const year = post.data.date.getFullYear().toString();
	if (!acc[year]) {
		acc[year] = [];
	}
	acc[year].push(post);
	return acc;
}, {});

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));
---

<BaseLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
	<Container>
		<div class="space-y-6">
			<h1 class="animate text-fg-bright text-xl font-semibold">Posts</h1>
			{
				years.map((year) => (
					<section class="animate space-y-2">
						<h2 class="text-fg-bright text-[0.85rem] font-semibold">{year}</h2>
						<div>
							{posts[year].map((post) => (
								<ArrowCard entry={post} class="py-4" />
							))}
						</div>
					</section>
				))
			}
		</div>
	</Container>
</BaseLayout>
