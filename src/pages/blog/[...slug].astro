---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ContentLayout from "@layouts/ContentLayout.astro";
import Container from "@components/Container.astro";
import { readingTime, formatDate, isSameDay } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";
import Schema from "@components/Schema.astro";
import { generateBlogPostingSchema } from "@lib/schema";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const lastModified = remarkPluginFrontmatter.lastModified
  ? new Date(remarkPluginFrontmatter.lastModified)
  : null;
const showUpdated = lastModified !== null && !isSameDay(lastModified, post.data.date);
const blogSchema = generateBlogPostingSchema(
  { ...post.data, lastModified },
  Astro.url,
);
---

<Schema schema={blogSchema} />

<ContentLayout title={post.data.title} description={post.data.description} mermaid={post.data.mermaid}>
  <Container>
    <div class="animate">
      <BackToPrev href="/blog">
        Back to blog
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <time datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(post.body ?? "")}
        </div>
      </div>
      {showUpdated && (
        <div class="animate font-base text-sm text-black/50 dark:text-white/50">
          Updated <time datetime={lastModified!.toISOString()}>
            {formatDate(lastModified!)}
          </time>
        </div>
      )}
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {post.data.title}
      </div>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</ContentLayout>
