---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ContentLayout from "@layouts/ContentLayout.astro";
import Container from "@components/Container.astro";
import Sidebar from "@components/Sidebar.astro";
import TableOfContents from "@components/TableOfContents.astro";
import BackToPrev from "@components/BackToPrev.astro";
import Schema from "@components/Schema.astro";
import { generateBlogPostingSchema } from "@lib/schema";
import { readingTime, formatDate, isSameDay } from "@lib/utils";

export async function getStaticPaths() {
	const posts = (await getCollection("blog"))
		.filter((post) => !post.data.draft)
		.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const lastModified = remarkPluginFrontmatter.lastModified
	? new Date(remarkPluginFrontmatter.lastModified)
	: null;
const showUpdated = lastModified !== null && !isSameDay(lastModified, post.data.date);
const blogSchema = generateBlogPostingSchema({ ...post.data, lastModified }, Astro.url);
---

<Schema schema={blogSchema} />

<ContentLayout
	title={post.data.title}
	description={post.data.description}
	mermaid={post.data.mermaid}
>
	<Container>
		<div class="animate mb-6">
			<BackToPrev href="/blog"> Back to blog </BackToPrev>
		</div>

		<Sidebar headings={headings} />

		{/* Desktop TOC — fixed to left of content */}
		<div class="toc-sidebar fixed top-24 hidden w-44 lg:block">
			<TableOfContents headings={headings} />
		</div>

		{/* Main content */}
		<div class="my-8 space-y-1">
			<div
				class="animate text-terminal-light-text dark:text-terminal-text flex items-center gap-1.5 text-sm"
			>
				<time datetime={post.data.date.toISOString()}>
					{formatDate(post.data.date)}
				</time>
				&bull;
				<span>{readingTime(post.body ?? "")}</span>
			</div>
			{
				showUpdated && (
					<div class="animate text-terminal-light-text-secondary dark:text-terminal-text-secondary text-sm">
						Updated <time datetime={lastModified!.toISOString()}>{formatDate(lastModified!)}</time>
					</div>
				)
			}
			<h1
				class="animate text-terminal-light-text dark:text-terminal-text text-2xl font-bold tracking-tight"
			>
				{post.data.title}
			</h1>
		</div>
		<article class="animate">
			<Content />
		</article>
	</Container>
</ContentLayout>

<script>
	import "../../scripts/toc.ts";
</script>
