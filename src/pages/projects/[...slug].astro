---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ContentLayout from "@layouts/ContentLayout.astro";
import Container from "@components/Container.astro";
import Sidebar from "@components/Sidebar.astro";
import TableOfContents from "@components/TableOfContents.astro";
import BackToPrev from "@components/BackToPrev.astro";
import Link from "@components/Link.astro";
import Schema from "@components/Schema.astro";
import { generateProjectSchema } from "@lib/schema";

export async function getStaticPaths() {
	const projects = (await getCollection("projects"))
		.filter((post) => !post.data.draft)
		.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}
type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content, headings } = await render(project);
const projectSchema = generateProjectSchema(project.data, Astro.url);
---

<Schema schema={projectSchema} />

<ContentLayout
	title={project.data.title}
	description={project.data.description}
	mermaid={project.data.mermaid}
>
	<Container>
		<div class="animate mb-6">
			<BackToPrev href="/projects"> Back to projects </BackToPrev>
		</div>

		<Sidebar headings={headings} />

		{/* Desktop TOC — fixed to left of content */}
		<div class="toc-sidebar fixed top-24 hidden w-44 lg:block">
			<TableOfContents headings={headings} />
		</div>

		{/* Main content */}
		<div class="animate mb-8">
			<h1
				class="text-terminal-light-text dark:text-terminal-text text-3xl font-bold tracking-tight"
			>
				{project.data.title}
			</h1>
			{
				(project.data.repoURL || project.data.websiteURL) && (
					<nav class="mt-2 flex gap-1">
						{project.data.repoURL && (
							<Link href={project.data.repoURL} external>
								repo
							</Link>
						)}
						{project.data.repoURL && project.data.websiteURL && <span>/</span>}
						{project.data.websiteURL && (
							<Link href={project.data.websiteURL} external>
								website
							</Link>
						)}
					</nav>
				)
			}
		</div>
		<article class="animate">
			<Content />
		</article>
	</Container>
</ContentLayout>

<script>
	import "../../scripts/toc.ts";
</script>
