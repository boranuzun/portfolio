---
import { Font } from "astro:assets";
import { type CollectionEntry, getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/Container.astro";
import TableOfContents from "@components/TableOfContents.astro";
import BackToPrev from "@components/BackToPrev.astro";
import Schema from "@components/Schema.astro";
import { generateProjectSchema } from "@lib/schema";

export async function getStaticPaths() {
	const projects = (await getCollection("projects"))
		.filter((post) => !post.data.draft)
		.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}
type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content, headings } = await render(project);
const projectSchema = generateProjectSchema(project.data, Astro.url);
---

<Schema schema={projectSchema} />

<BaseLayout title={project.data.title} description={project.data.description}>
	<Font slot="head" cssVariable="--font-serif" preload />
	<Container>
		<div class="xl:grid xl:grid-cols-[11rem_1fr] xl:gap-8">
			<aside class="hidden xl:block">
				<div class="sticky top-20 flex flex-col gap-6">
					<BackToPrev href="/projects/"> Back to projects </BackToPrev>
					<TableOfContents headings={headings} />
				</div>
			</aside>

			<div class="animate">
				<div class="mb-10 space-y-1">
					<h1 class="text-fg-bright text-3xl font-semibold">
						{project.data.title}
					</h1>
					{
						(project.data.repoURL || project.data.websiteURL) && (
							<nav class="flex gap-2 text-sm">
								{project.data.repoURL && (
									<a
										href={project.data.repoURL}
										target="_blank"
										class="text-link transition-opacity duration-200 hover:opacity-80"
									>
										repo
									</a>
								)}
								{project.data.repoURL && project.data.websiteURL && (
									<span class="text-fg-dim">/</span>
								)}
								{project.data.websiteURL && (
									<a
										href={project.data.websiteURL}
										target="_blank"
										class="text-link no-underline transition-opacity duration-200 hover:opacity-80"
									>
										website
									</a>
								)}
							</nav>
						)
					}
				</div>
				<article>
					<Content />
				</article>
			</div>
		</div>
	</Container>
</BaseLayout>

<script>
	import "../../scripts/toc.ts";
</script>
