---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ContentLayout from "@layouts/ContentLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";
import Link from "@components/Link.astro";
import Schema from "@components/Schema.astro";
import { generateProjectSchema } from "@lib/schema";

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}
type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content } = await render(project);
const projectSchema = generateProjectSchema(project.data, Astro.url);
---

<Schema schema={projectSchema} />

<ContentLayout title={project.data.title} description={project.data.description} mermaid={project.data.mermaid}>
  <Container>
    <div class="animate">
      <BackToPrev href="/projects">
        Back to projects
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={project.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(project.body)}
        </div>
      </div>
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {project.data.title}
      </div>
      {(project.data.repoURL || project.data.websiteURL) && (
        <nav class="animate flex gap-1">
          {project.data.repoURL && (
            <Link href={project.data.repoURL} external>
              repo
            </Link>
          )}
          {project.data.repoURL && project.data.websiteURL && (
            <span>/</span>
          )}
          {project.data.websiteURL && (
            <Link href={project.data.websiteURL} external>
              website
            </Link>
          )}
        </nav>
      )}
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</ContentLayout>