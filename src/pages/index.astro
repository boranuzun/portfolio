---
import { getCollection, render } from "astro:content";
import Container from "@components/Container.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import SkillGrid from "@components/SkillGrid.astro";
import WorkEntry from "@components/WorkEntry.astro";
import ArrowCard from "@components/ArrowCard.astro";
import SocialLinks from "@components/SocialLinks.astro";
import Link from "@components/Link.astro";
import { SITE, HOME } from "@consts";
import skillsData from "@data/skills.json";
import { getPublishedEntries } from "@lib/collections";

const blog = (await getPublishedEntries("blog")).slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
const projects = (await getPublishedEntries("projects")).slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
	.sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
	.slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
	allwork.map(async (item) => {
		const { Content } = await render(item);
		return { ...item, Content };
	}),
);
---

<BaseLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
	<Container>
		<div class="space-y-16">
			{/* Hero */}
			<section class="animate">
				<h1 class="text-fg-bright text-3xl font-semibold tracking-tight">Hi, I'm Boran 👋🏼</h1>
				<div class="text-fg-muted mt-1 text-base">
					Aspiring DevOps Engineer &middot; Network &amp; Systems Administrator
				</div>
				<div class="mt-2 flex gap-3 text-sm italic">
					<Link href="/cv/cv-eng.pdf" external>&#127468;&#127463; CV in English</Link>
					<Link href="/cv/cv.pdf" external>&#127467;&#127479; CV en Français</Link>
				</div>
				<div class="text-fg mt-6 space-y-4">
					<p class="animate">
						I'm a recent graduate, with a BSc in Business Information Technology, looking to start
						my career in DevOps or network and systems administration. I've spent a lot of my time
						building a homelab and experimenting with automation, which is where I really found my
						interest in infrastructure.
					</p>
					<p class="animate">
						I'm passionate about networking, DevOps, and open-source projects. More recently, I've
						been diving into AI agents, getting my hands dirty with multi-agent systems, MCP servers
						and building agent skills. I love the challenge of automating systems and seeing
						everything work together efficiently.
					</p>
					<p class="animate">
						Right now, I'm looking for a junior position or internship where I can put my skills to
						use and keep learning from an experienced team.
					</p>
				</div>
			</section>

			{/* Skills */}
			<section class="animate space-y-4">
				<h5 class="text-fg-bright font-semibold">Skills & Technologies</h5>
				<SkillGrid categories={skillsData.categories} />
			</section>

			{/* Work */}
			<section class="animate space-y-6">
				<div class="flex flex-wrap items-center justify-between gap-y-2">
					<h5 class="text-fg-bright font-semibold">Work Experience</h5>
					<Link href="/work">See all work</Link>
				</div>
				<div class="space-y-4">
					{
						work.map((entry) => {
							const isActive = entry.data.dateEnd === "Present";
							return (
								<WorkEntry
									company={entry.data.company}
									role={entry.data.role}
									dateStart={entry.data.dateStart}
									dateEnd={entry.data.dateEnd}
									active={isActive}
								/>
							);
						})
					}
				</div>
			</section>

			{/* Projects */}
			<section class="animate space-y-6">
				<div class="flex flex-wrap items-center justify-between gap-y-2">
					<h5 class="text-fg-bright font-semibold">Recent Projects</h5>
					<Link href="/projects">See all projects</Link>
				</div>
				<div>
					{projects.map((project) => <ArrowCard entry={project} />)}
				</div>
			</section>

			{/* Blog */}
			<section class="animate space-y-6">
				<div class="flex flex-wrap items-center justify-between gap-y-2">
					<h5 class="text-fg-bright font-semibold">Latest Posts</h5>
					<Link href="/blog">See all posts</Link>
				</div>
				<div>
					{blog.map((post) => <ArrowCard entry={post} class="py-2" showMeta={false} />)}
				</div>
			</section>

			{/* Connect */}
			<section class="animate space-y-4">
				<h5 class="text-fg-bright font-semibold">Let's Connect</h5>
				<p class="text-fg">
					If you want to get in touch with me about something or just to say hi, reach out on social
					media or send me an email.
				</p>
				<SocialLinks />
			</section>
		</div>
	</Container>
</BaseLayout>
