---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
---

<PageLayout title="404" description="Page not found.">
  <Container>
    <div class="flex flex-col items-center justify-center min-h-[50vh] text-center space-y-6">
      <h1 class="animate font-bold text-black dark:text-white text-7xl sm:text-9xl tracking-tighter">
        404
      </h1>
      <p class="animate text-lg text-black/70 dark:text-white/70 max-w-sm mx-auto">
        Oops! The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="animate pt-4">
        <a href="/" class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 transition-colors font-medium text-black dark:text-white">
          &larr; Back to Home
        </a>
      </div>
    </div>
  </Container>
</PageLayout>
