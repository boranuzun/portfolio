---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import CommandPalette from "@components/CommandPalette.astro";
import CRTOverlay from "@components/CRTOverlay.astro";

type Props = {
	title: string;
	description: string;
};

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<Head title={`~/${title.toLowerCase()}`} description={description} />
		<slot name="head" />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<CommandPalette />
		<CRTOverlay />
	</body>
</html>
