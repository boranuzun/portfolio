		"@lucide/astro": "^1.7.0",
		"@tailwindcss/typography": "^0.5.19",
		"@typescript-eslint/eslint-plugin": "^8.58.0",
		"@typescript-eslint/parser": "^8.58.0",
		"astro-expressive-code": "^0.41.7",
		"clsx": "^2.1.1",
		"d3": "^7.9.0",
		"dayjs": "^1.11.20",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"playwright": "^1.59.1",
		"rehype-mermaid": "^3.0.0",
